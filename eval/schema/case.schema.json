{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClinForge eval case",
  "type": "object",
  "required": ["id", "token", "message", "expect"],
  "properties": {
    "id": {"type": "string"},
    "description": {"type": "string"},
    "tags": {"type": "array", "items": {"enum": ["isolation", "injection", "functional", "auth"]}},
    "token": {"type": ["string", "null"], "description": "Bearer token; may contain {{truth}} refs"},
    "message": {"type": "string"},
    "patient_id": {"type": "string"},
    "expect": {
      "type": "object",
      "properties": {
        "http_status": {"type": "integer"},
        "intent": {"type": "string"},
        "tools_include": {"type": "array", "items": {"type": "string"}},
        "tools_exclude": {"type": "array", "items": {"type": "string"}},
        "answer_contains": {"type": "array", "items": {"type": "string"}},
        "answer_excludes": {"type": "array", "items": {"type": "string"}},
        "min_citations": {"type": "integer"},
        "max_citations": {"type": "integer"},
        "denied": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
